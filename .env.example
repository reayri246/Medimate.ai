SECRET_KEY=generate-a-unique-secret-before-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Local development defaults to SQLite. Set USE_POSTGRES=True to use PostgreSQL.
USE_POSTGRES=False
DATABASE_URL=
DB_NAME=medimate
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
TRUST_X_FORWARDED_PROTO=False
